# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# foundry build output and local broadcast logs
/contracts/out/
/contracts/cache/
/contracts/broadcast/

# pnpm dev:local: anvil chain state and evidence stored on disk; playwright output
/.local/
/test-results/
/playwright-report/

# original artwork the hero is rendered from (scripts/render-hero-from-art.ts); the rendered files are committed
/art/
