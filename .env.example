# Required to boot (Stage 1 on)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_CHAIN_ID=

# Optional until the stage that uses them. src/env.ts does not check these at boot;
# requireEnv("NAME") asserts each where it is used and names the stage on failure.

# Stage 3: blob storage adapter
BLOB_READ_WRITE_TOKEN=

# Stage 4: hourly queue drain, /api/internal/jobs/drain
CRON_SECRET=

# Stage 5: advisory AI audit job. GEMINI_API_KEY may stay empty: the job then
# reports ai_unavailable instead of failing.
GEMINI_API_KEY=
GEMINI_MODEL=

# Stage 6: anchoring. ANCHOR_PRIVATE_KEY is server only, never NEXT_PUBLIC_.
BASE_SEPOLIA_RPC_URL=
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=
# Stage 6: set after the contract is deployed; the proof page reads it in Stage 7
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Stage 4: keys the opaque matchRef on cross-organisation findings (32+ characters)
FORENSICS_MATCH_KEY=

# Operators run /admin: anchoring, reviewer assignment, the job queue, duplicate
# matches. Comma-separated email addresses. Email verification is off, so register
# each operator account BEFORE listing its address on a deployment others can join.
OPERATOR_EMAILS=

# X1 satellite cross-check: "true" lets the job query the free Earth Search archive.
# Unset, every submission gets an "inconclusive: not enabled" note instead.
NDVI_ENABLED=

# Demo build only: "true" enables the role switcher and tamper demo, and makes the
# seeded audit-admin@delta-demo.example an operator
DEMO_MODE=
